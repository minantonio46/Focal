<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.focal.pocketbase</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/pocketbase/pocketbase</string>
    <string>serve</string>
    <string>--http=0.0.0.0:8090</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/pocketbase</string>

  <!-- 맥 로그인 시 자동 실행 -->
  <key>RunAtLoad</key>
  <true/>

  <!-- 비정상 종료 시 자동 재시작 -->
  <key>KeepAlive</key>
  <true/>

  <!-- 로그 파일 -->
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/pocketbase/logs/pocketbase.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/pocketbase/logs/pocketbase-error.log</string>
</dict>
</plist>
